# Supabase (required for live mode)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# One server-side payment endpoint. Do NOT put provider secret keys in Vite env.
# Expected POST body: { provider, amountCents, currency, orderId }
# Expected JSON response: { status, transactionId, ... }
VITE_PAYMENT_FUNCTION_URL=

# AI Assistant (optional server-side proxy)
VITE_AI_ASSISTANT_ENDPOINT=/api/assistant
